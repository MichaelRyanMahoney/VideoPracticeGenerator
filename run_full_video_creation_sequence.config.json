{
  "blender_binary": "/Applications/Blender.app/Contents/MacOS/Blender",
  "default_character_blend": "assets/DefaultCharacter.blend",
  "base_scene_blend": "scenes/base_scene.blend",
  "generator_inputs_json": "manifests/generator_inputs.json",
  "script_txt": "script.txt",
  "manifest_csv_out": "manifests/lines.csv",
  "director_json_out": "director_visemes.json",
  "out_video": "out/blender_render.mp4",
  "background_image": "scenes/SceneBackground.png",
  "cleanup_temp": true,
  "run_generate_characters": true,
  "run_export_characters": true,
  "export_characters_output_dir": "out/exports/characters",
  "export_image_width": 1200,
  "export_file_prefix": "Char",
  "export_table_object_name": "Dining table round for 4 people",
  "export_table_file_prefix": "Table",
  "hdri_path": "assets/brown_photostudio_02_4k.hdr",
  "hdri_strength": 0.7,
  "force_tts": false,
  "use_smart_prompt_tts": true,
  "smart_prompt_context_char_limit": 2000,
  "smart_prompt_include_speaker_labels": false,
  "force_whisper": false,
  "skip_render": true,
  "skip_mux": false,
  "run_apply_overlays": true,
  "overlay_config": "scripts/apply_overlays.config.json",
  "overlay_image": "scenes/VideoPauseOverlay1.png",
  "overlay_out": "out/blender_render_with_overlays.mp4",
  "overlay_fps": 24,
  "mux_fg_width_ratio": 0.73,
  "enforce_render_frame_guard": true,
  "render_frame_guard_pad_sec": 2.0,
  "max_frame_end": 12000
}


