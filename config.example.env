# --- AWS region ---
AWS_REGION=us-east-1

# --- Storage ---
VPG_S3_BUCKET=your-bucket-name
VPG_S3_PREFIX=vpg

# --- Queue (CPU worker pulls jobs) ---
VPG_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/vpg-jobs

# --- GPU Executor (Option A: dedicated GPU EC2 instance, no Batch) ---
# If set, the CPU worker will call this service instead of submitting AWS Batch jobs.
# Example (private VPC IP): http://172.31.38.70:9000
VPG_GPU_EXECUTOR_URL=
# Optional shared secret header (recommended if the port is reachable beyond a strict SG rule)
VPG_GPU_EXECUTOR_TOKEN=

# --- Single-node GPU mode (no Batch, no GPU executor HTTP) ---
# If set to 1, the worker will run scene+director+render locally on the same machine.
VPG_RUN_GPU_LOCALLY=0

# --- Batch (GPU) ---
VPG_BATCH_JOB_QUEUE_GPU=vpg-gpu-queue
VPG_BATCH_JOB_DEF_GPU_DIRECTOR=vpg-gpu-director:1
VPG_BATCH_JOB_DEF_GPU_RENDER=vpg-gpu-render:1
VPG_RENDER_SHARDS=8

# Optional: enable /admin/gpu/warm and /admin/gpu/off
VPG_BATCH_COMPUTE_ENV=vpg-gpu-compute-env

# --- Typecast (CPU TTS) ---
TYPECAST_API_KEY=replace_me

# --- Optional: run CPU finalize (mux/upload/email) after GPU render completes ---
VPG_RUN_FINALIZE=1

# Optional: overlay config
# VPG_OVERLAY_CONFIG_S3=s3://your-bucket-name/vpg/projects/Video-01/overlays/apply_overlays.config.json

# Optional: SES
# VPG_EMAIL_FROM=support@mediatorspark.com
# VPG_EMAIL_TO=support@mediatorspark.com

